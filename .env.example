# Deal Truth ML — copy to .env (`cp .env.example .env`). Never commit real tokens.
#
# Local: npm run dev  (NestJS on PORT, default 8081)
# Render: npm ci && npm run build   then   npm run start:prod
#
# YOU MUST FILL: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
# Production: also set INTERNAL_API_TOKEN (same value as deal-truth ML_SERVICE_API_KEY)

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
INTERNAL_API_TOKEN=
PORT=8081

ENABLE_GENERATION=true
MAX_BATCH_SIZE=32
MAX_TEXT_CHARS=8000
LOG_LEVEL=info
FAST_MODEL_ID=@cf/qwen/qwen3-30b-a3b-fp8
QUALITY_MODEL_ID=@cf/openai/gpt-oss-120b
EMBEDDING_MODEL_ID=@cf/qwen/qwen3-embedding-0.6b
RERANK_MODEL_ID=@cf/baai/bge-reranker-base
EMBEDDING_DIMENSION=1024
